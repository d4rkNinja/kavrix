{
  "name": "kavrix-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-knowledge credentials vault monorepo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d4rkNinja/kavrix.git"
  },
  "homepage": "https://github.com/d4rkNinja/kavrix#readme",
  "bugs": {
    "url": "https://github.com/d4rkNinja/kavrix/issues"
  },
  "keywords": [
    "credentials",
    "password-manager",
    "security",
    "terminal",
    "zero-knowledge"
  ],
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.12.0 <25 || >=25.1.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @kavrix/tui --if-present build && pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @kavrix/tui --if-present typecheck && pnpm -r --if-present typecheck",
    "verify": "pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:quick": "node scripts/verify-all.mjs --quick",
    "verify:release": "pnpm test:coverage",
    "acceptance:pre-ci": "node acceptance/pre-ci/all-commands/run.js",
    "acceptance:database-container": "node acceptance/pre-ci/database-container/run.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "@kavrix/core": "workspace:*",
    "@kavrix/crypto": "workspace:*",
    "@kavrix/key-files": "workspace:*",
    "@kavrix/runner": "workspace:*",
    "@kavrix/schemas": "workspace:*",
    "@kavrix/storage": "workspace:*",
    "@kavrix/tui": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.28.1",
    "ink": "catalog:",
    "react": "catalog:",
    "yaml": "2.8.3",
    "zod": "4.4.3"
  },
  "dependencies": {
    "kavrix": "link:apps/cli"
  }
}
