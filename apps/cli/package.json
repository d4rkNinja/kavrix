{
  "name": "kavrix",
  "version": "0.1.0",
  "description": "Zero-knowledge credential vault command-line interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d4rkNinja/kavrix.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/d4rkNinja/kavrix#readme",
  "bugs": {
    "url": "https://github.com/d4rkNinja/kavrix/issues"
  },
  "keywords": [
    "credentials",
    "password-manager",
    "security",
    "terminal",
    "zero-knowledge"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "creds": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/*.cdx.json"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --pretty false && node scripts/build-package.js",
    "typecheck": "tsc -b tsconfig.build.json --pretty false && tsc -p tsconfig.json --pretty false",
    "test": "pnpm run build && vitest run --root ../.. apps/cli/test",
    "test:coverage": "pnpm run build && vitest run --root ../.. apps/cli/test --coverage --coverage.include=apps/cli/src/**",
    "prepack": "pnpm run build",
    "pack:check": "pnpm pack --dry-run --json",
    "package:smoke": "pnpm run build && node scripts/smoke-packed-package.js"
  },
  "devDependencies": {
    "@kavrix/client": "workspace:*",
    "@kavrix/clipboard": "workspace:*",
    "@kavrix/core": "workspace:*",
    "@kavrix/crypto": "workspace:*",
    "@kavrix/key-files": "workspace:*",
    "@kavrix/keychain": "workspace:*",
    "@kavrix/local-store": "workspace:*",
    "@kavrix/schemas": "workspace:*",
    "@kavrix/sync": "workspace:*",
    "commander": "catalog:",
    "esbuild": "0.28.1",
    "zod": "catalog:"
  }
}
