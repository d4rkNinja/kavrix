{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": false,
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": [
    "src/bin.ts",
    "src/database-commands.ts",
    "src/database-flat-commands.ts",
    "src/database-migration-command.ts",
    "src/database-migration.ts",
    "src/database-session.ts",
    "src/datastore-profiles.ts",
    "src/index.ts",
    "src/init-onboarding.ts",
    "src/local-secrets.ts",
    "src/local-vault-cli.ts",
    "src/version.ts"
  ],
  "exclude": ["test/**/*.ts"],
  "references": [
    { "path": "../../packages/schemas/tsconfig.build.json" },
    { "path": "../../packages/crypto/tsconfig.build.json" },
    { "path": "../../packages/key-files/tsconfig.build.json" },
    { "path": "../../packages/storage/tsconfig.build.json" }
  ]
}
