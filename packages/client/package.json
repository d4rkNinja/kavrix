{
  "name": "@kavrix/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli-contracts": {
      "types": "./dist/cli-contracts.d.ts",
      "import": "./dist/cli-contracts.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.12.0 <25 || >=25.1.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json \"tsconfig*.json\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b tsconfig.build.json --pretty false && tsc -p tsconfig.json --pretty false",
    "test": "vitest run --root ../.. packages/client/test"
  },
  "dependencies": {
    "@kavrix/clipboard": "workspace:*",
    "@kavrix/core": "workspace:*",
    "@kavrix/crypto": "workspace:*",
    "@kavrix/import-export": "workspace:*",
    "@kavrix/key-files": "workspace:*",
    "@kavrix/schemas": "workspace:*",
    "@kavrix/storage": "workspace:*",
    "@kavrix/sync": "workspace:*",
    "zod": "catalog:"
  }
}
