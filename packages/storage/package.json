{
  "name": "@kavrix/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.12.0 <25 || >=25.1.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty false && tsc -p tsconfig.json --pretty false",
    "test": "vitest run --root ../.. --config packages/storage/vitest.config.ts"
  },
  "dependencies": {
    "@kavrix/key-files": "workspace:*",
    "@kavrix/schemas": "workspace:*",
    "mongodb": "catalog:"
  },
  "devDependencies": {
    "@kavrix/crypto": "workspace:*"
  }
}
