{
  "name": "@kavrix/local-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.12.0 <25 || >=25.1.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json README.md \"tsconfig*.json\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b tsconfig.build.json --pretty false && tsc -p tsconfig.json --pretty false",
    "test": "vitest run --root ../.. packages/local-store/test"
  },
  "dependencies": {
    "@kavrix/client": "workspace:*",
    "@kavrix/keychain": "workspace:*",
    "@kavrix/schemas": "workspace:*",
    "@kavrix/sync": "workspace:*"
  }
}
